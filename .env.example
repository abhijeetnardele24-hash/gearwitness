# GearWitness Environment Configuration
# Operating Mode: "fixture" (deterministic public demo) or "local" (real Ollama/Gemma + OpenCV)
APP_MODE=fixture

# Server Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./gearwitness.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Open-Source / Open-Weight AI (Local Gemma via Ollama)
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL_NAME=gemma2:9b
MODEL_TIMEOUT_SECONDS=45

# Optional: Sentry Tracing (leave blank unless active)
SENTRY_DSN=
